# Dovecot SQL configuration for virtual mail users

driver = mysql

connect = host=127.0.0.1 dbname=mailserver user=mailuser password=CHANGE_ME_DB_PASSWORD

default_pass_scheme = SHA512-CRYPT

password_query = \
  SELECT email AS user, password \
  FROM virtual_users \
  WHERE email='%u';

user_query = \
  SELECT 5000 AS uid, 5000 AS gid, \
  '/var/mail/vhosts/%d/%n' AS home, \
  'maildir:/var/mail/vhosts/%d/%n/Maildir' AS mail \
  FROM virtual_users \
  WHERE email='%u';
